# ── Runtime ──
NODE_ENV=production

# ── Database (PostgreSQL + PostGIS) ──
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=disability_map

# ── Backend Server ──
PORT=4000
# Comma-separated list of allowed frontend origins (for CORS)
# Example: http://localhost:3000,https://dmap.yourdomain.com
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=change_me_to_a_random_secret
JWT_REFRESH_SECRET=change_me_to_another_random_secret

# ── Frontend (Next.js — must start with NEXT_PUBLIC_) ──
# Full URL or relative path to the backend API.
# Recommendation: use '/api' to route through the Nginx proxy automatically.
NEXT_PUBLIC_API_URL=/api
# Map style URL. Use 'https://tiles.openfreemap.org/styles/liberty' for free remote tiles
# Or 'http://localhost:3636/styles/liberty/style.json' if using local Martin server
NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/liberty

# ── Cloudinary (Image Uploads) ──
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── AI Configuration ──
# Supported providers: gemini | openai | anthropic | custom
AI_PROVIDER=gemini
# API key for your chosen provider (get from AI Studio, OpenAI, etc.)
AI_API_KEY=
# Model name — depends on provider:
#   Gemini:  gemini-2.5-flash, gemini-2.5-pro
#   OpenAI:  gpt-4o-mini, gpt-4o
#   Custom:  depends on your server
AI_MODEL=gemini-2.5-flash
# Custom base URL — leave empty to use provider's default endpoint.
# Set this for OpenRouter, local LLM servers, etc.
#   OpenRouter:  https://openrouter.ai/api/v1
#   Local LLM:   http://localhost:1234/v1
#   Ollama:      http://localhost:11434/v1
#   vLLM:        http://your-gpu-server:8000/v1
AI_BASE_URL=

